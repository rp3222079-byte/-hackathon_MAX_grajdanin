# Скопируйте в .env: cp .env.example .env
# Рабочие значения хранятся только в .env — он не попадает в репозиторий.

# --- MAX ---
# Токен бота: business.max.ru → «Чат-боты» → «Интеграция» → «Получить токен»
MAX_BOT_TOKEN=
# Адрес MAX Bot API по документации dev.max.ru
MAX_API_BASE_URL=https://platform-api2.max.ru

# --- API «Домового» ---
# Общий ключ бота и API (заголовок X-API-Key) и секрет подписи ссылок для УК.
# Для публичного запуска замените на случайную строку: openssl rand -hex 32
API_TOKEN=local-dev-token-change-me
# Внешний адрес API: из него собирается ссылка для УК в письме
PUBLIC_BASE_URL=http://localhost:8000
# Порт API на хосте (docker compose)
API_PORT=8000
# Часовой пояс города: время отключений и обращений
TIMEZONE=Asia/Novosibirsk
# Адрес API для бота и строка подключения к БД при запуске без Docker.
# В docker compose перекрываются на http://api:8000 и PostgreSQL.
API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./domovoy.db

# --- Бот ---
# Файл с незаконченными диалогами (переживает перезапуск бота)
BOT_STATE_PATH=bot_state.json
# Геокодер для кнопки «Отправить геолокацию» (OpenStreetMap Nominatim).
# Пустое значение выключает кнопку.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

# --- Почта для обращений в УК ---
# true — письма не отправляются, а сохраняются в outbox/*.eml (режим проверки)
SMTP_DRY_RUN=true
# Демонстрация: все письма уходят на этот адрес вместо почты УК
MAIL_REDIRECT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
