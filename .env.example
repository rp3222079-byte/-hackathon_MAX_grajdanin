# --- MAX ---
# Токен бота: business.max.ru → «Чат-боты» → «Интеграция» → «Получить токен»
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api.max.ru

# --- Наш API ---
# Адрес API для бота. В Docker перекрывается на http://api:8000
API_BASE_URL=http://localhost:8000
# Локально SQLite; в Docker перекрывается на PostgreSQL
DATABASE_URL=sqlite:///./domovoy.db

# --- Почта для обращений в УК ---
# true — письма не отправляются, а сохраняются в outbox/*.eml (режим для проверки)
SMTP_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
